[Unit]
Description=Livewall animated wallpaper
Documentation=file://%h/.local/share/livewall/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/livewall daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=graphical-session.target
