#!/usr/bin/env python3
"""Launcher: finds the livewall package next to this script (source tree) or in
~/.local/share/livewall (installed)."""
import os
import sys
from pathlib import Path

here = Path(os.path.realpath(__file__)).parent
for root in (here.parent, Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "livewall"):
    if (root / "livewall" / "cli.py").is_file():
        sys.path.insert(0, str(root))
        break

from livewall.cli import main  # noqa: E402

sys.exit(main())
